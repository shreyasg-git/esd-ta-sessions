<script>
(function(){
  /* ---- make every section heading its own link ---- */
  document.querySelectorAll('section[id]').forEach(function(sec){
    var h=sec.querySelector('.shead h2');
    if(!h||h.querySelector('.anch')) return;
    var a=document.createElement('a');
    a.className='anch';
    a.href='#'+sec.id;
    a.textContent='#';
    a.setAttribute('aria-label','Link to this section');
    h.appendChild(a);
  });

  /* ---- handle all in-page links ourselves ----
     Fragment hrefs get resolved against the host page URL in some
     embedded/iframed contexts, which breaks them. Scrolling manually
     works the same whether this file is opened locally, served from
     a static host, or previewed inside another page. */
  function goTo(id,push){
    var el=document.getElementById(id);
    if(!el) return false;
    el.scrollIntoView({behavior:'smooth',block:'start'});
    if(push){ try{ history.replaceState(null,'','#'+id); }catch(err){} }
    return true;
  }
  document.addEventListener('click',function(e){
    var a=e.target.closest && e.target.closest('a[href^="#"]');
    if(!a) return;
    var id=a.getAttribute('href').slice(1);
    if(!id) return;
    if(goTo(id,true)) e.preventDefault();
  });

  /* ---- honour a hash in the URL on first load ---- */
  if(location.hash.length>1){
    var target=decodeURIComponent(location.hash.slice(1));
    window.addEventListener('load',function(){setTimeout(function(){goTo(target,false)},60)});
  }

  var checks=[].slice.call(document.querySelectorAll('.chk'));
  var doneEl=document.getElementById('done'),totalEl=document.getElementById('total');
  var fill=document.getElementById('fill'),msg=document.getElementById('msg');
  totalEl.textContent=checks.length;
  var notes=['Work through it at whatever pace suits you.',
             'Good start — the box model and the cascade carry everything else.',
             'Past halfway. Flexbox and Grid are the fun part.',
             'Nearly there. The practice run is where it sticks.',
             "All done — nothing to hand in. You're ready."];
  function update(){
    var n=checks.filter(function(c){return c.checked}).length;
    var pct=checks.length?n/checks.length:0;
    doneEl.textContent=n;
    fill.style.width=(pct*100)+'%';
    fill.classList.toggle('done',n===checks.length);
    msg.textContent=n===checks.length?notes[4]:notes[Math.min(3,Math.floor(pct*4))];
  }
  checks.forEach(function(c){c.addEventListener('change',update)});
  update();
  document.querySelectorAll('.cmd').forEach(function(block){
    var b=document.createElement('button');
    b.className='copy';b.type='button';b.textContent='Copy';
    b.addEventListener('click',function(e){
      e.preventDefault();e.stopPropagation();
      var c=block.cloneNode(true);
      c.querySelectorAll('.copy,.o,.cm').forEach(function(n){n.remove()});
      var s=c.textContent.split('\n').map(function(l){return l.replace(/^[$>]\s?/,'').trimEnd()}).join('\n').replace(/\n{3,}/g,'\n\n').trim();
      function ok(){b.textContent='Copied';setTimeout(function(){b.textContent='Copy'},1400)}
      if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(s).then(ok,function(){})}
      else{var ta=document.createElement('textarea');ta.value=s;document.body.appendChild(ta);ta.select();try{document.execCommand('copy');ok()}catch(err){}document.body.removeChild(ta)}
    });
    block.appendChild(b);
  });
})();
</script>
</body>
</html>
