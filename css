        <line x1="60" y1="42" x2="60" y2="280"/><line x1="250" y1="42" x2="250" y2="280"/>
        <line x1="420" y1="42" x2="420" y2="280"/><line x1="590" y1="42" x2="590" y2="280"/>
        <line x1="46" y1="56" x2="604" y2="56"/><line x1="46" y1="160" x2="604" y2="160"/><line x1="46" y1="264" x2="604" y2="264"/>
      </g>
      <g font-family="IBM Plex Mono, monospace" font-size="11.5" fill="#8A6D08" font-weight="600" text-anchor="end">
        <text x="40" y="60">1</text><text x="40" y="164">2</text><text x="40" y="268">3</text>
      </g>

      <rect x="70" y="66" width="170" height="84" fill="#E4EEEB" stroke="#0B5D51" stroke-width="2"/>
      <text x="155" y="113" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" fill="#0B5D51">cell</text>

      <rect x="260" y="66" width="320" height="84" fill="#101614"/>
      <text x="420" y="106" text-anchor="middle" font-family="IBM Plex Sans Condensed, sans-serif" font-size="14" font-weight="700" fill="#F5C518">AREA — spans 2 columns</text>
      <text x="420" y="126" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill="#B7C4C0">grid-column: 2 / 4</text>

      <rect x="70" y="170" width="170" height="84" fill="#E4EEEB" stroke="#0B5D51" stroke-width="2"/>
      <rect x="260" y="170" width="150" height="84" fill="#E4EEEB" stroke="#0B5D51" stroke-width="2"/>
      <rect x="430" y="170" width="150" height="84" fill="#E4EEEB" stroke="#0B5D51" stroke-width="2"/>

      <line x1="240" y1="212" x2="260" y2="212" stroke="#E06C4F" stroke-width="3"/>
      <text x="250" y="300" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill="#E06C4F" font-weight="600">gap</text>
      <line x1="250" y1="288" x2="250" y2="220" stroke="#E06C4F" stroke-width="1.5" stroke-dasharray="3 3"/>

      <g font-family="IBM Plex Sans, sans-serif" font-size="12.5" fill="#2B3936">
        <text x="620" y="76">Lines are numbered</text>
        <text x="620" y="94">from 1, and they're</text>
        <text x="620" y="112">what you place items</text>
        <text x="620" y="130">between.</text>
        <text x="620" y="170">A track is the space</text>
        <text x="620" y="188">between two lines —</text>
        <text x="620" y="206">a column or a row.</text>
        <text x="620" y="246">An area is any</text>
        <text x="620" y="264">rectangle of cells.</text>
      </g>
    </svg>
    <figcaption>You place items between numbered <em>lines</em>, not into cells. Four lines make three columns — this off-by-one catches everyone once.</figcaption>
  </figure>

  <div class="mention">
    <div class="mrow"><b>Track</b><span>One column or one row.</span></div>
    <div class="mrow"><b>Line</b><span>The dividing line between tracks, numbered from 1. <strong>N tracks means N+1 lines.</strong></span></div>
    <div class="mrow"><b>Cell</b><span>One column crossed with one row.</span></div>
    <div class="mrow"><b>Area</b><span>Any rectangle of cells, which one item can occupy.</span></div>
    <div class="mrow"><b>Gap</b><span>Space between tracks. Not a track itself, and not affected by margins.</span></div>
  </div>

  <h3>Defining tracks</h3>
  <div class="cmd"><span class="at">grid-template-columns</span>: <span class="st">200px 200px 200px</span>;    <span class="cm">/* three fixed */</span>
<span class="at">grid-template-columns</span>: <span class="st">repeat(3, 200px)</span>;      <span class="cm">/* same, less typing */</span>
<span class="at">grid-template-columns</span>: <span class="st">1fr 1fr 1fr</span>;           <span class="cm">/* three equal, fluid */</span>
<span class="at">grid-template-columns</span>: <span class="st">250px 1fr</span>;             <span class="cm">/* sidebar + rest */</span>
<span class="at">grid-template-columns</span>: <span class="st">1fr 2fr</span>;               <span class="cm">/* one third, two thirds */</span>
<span class="at">grid-template-columns</span>: <span class="st">minmax(200px, 1fr) 3fr</span>; <span class="cm">/* never below 200px */</span></div>

  <div class="cue"><p class="cue-k">fr is the unit that makes Grid pleasant</p><p><code>1fr</code> means "one share of the space left after fixed sizes and gaps are subtracted". Unlike percentages, it accounts for the gaps automatically — so <code>repeat(3, 1fr)</code> with a <code>2rem</code> gap just works, where <code>33.33%</code> three times overflows.</p></div>

  <label class="done-check"><input type="checkbox" class="chk"><span class="dbox"></span><span>Section 12 complete</span></label>
</section>

<!-- ================= 13 ================= -->
<section id="s13">
  <div class="shead"><span class="chip">13</span><h2>Grid — placing items</h2><span class="tagline">by line, or by name</span></div>

  <p>By default items fill cells in order. To place one deliberately, name the lines it should sit between.</p>

  <div class="cmd"><span class="tg">.hero</span> {
  <span class="at">grid-column</span>: <span class="st">1 / 3</span>;    <span class="cm">/* from line 1 to line 3 — spans 2 columns */</span>
  <span class="at">grid-row</span>: <span class="st">1 / 2</span>;
}

<span class="tg">.wide</span>  { <span class="at">grid-column</span>: <span class="st">span 2</span>; }    <span class="cm">/* 2 columns from wherever it lands */</span>
<span class="tg">.full</span>  { <span class="at">grid-column</span>: <span class="st">1 / -1</span>; }    <span class="cm">/* -1 is the last line: full width */</span></div>

  <p><code>1 / -1</code> is worth memorising — it means "edge to edge" regardless of how many columns there are, so it keeps working when the layout changes.</p>

  <h3>Named areas — the readable way</h3>
  <p>For page-level layout this is hard to beat, because the CSS looks like the thing it produces.</p>

  <div class="cmd"><span class="tg">.page</span> {
  <span class="at">display</span>: <span class="st">grid</span>;
  <span class="at">grid-template-columns</span>: <span class="st">240px 1fr</span>;
  <span class="at">grid-template-rows</span>: <span class="st">auto 1fr auto</span>;
  <span class="at">min-height</span>: <span class="st">100dvh</span>;
  <span class="at">grid-template-areas</span>:
    <span class="st">"header  header"</span>
    <span class="st">"sidebar main"</span>
    <span class="st">"footer  footer"</span>;
}

<span class="tg">header</span>  { <span class="at">grid-area</span>: <span class="st">header</span>; }
<span class="tg">.sidebar</span> { <span class="at">grid-area</span>: <span class="st">sidebar</span>; }
<span class="tg">main</span>    { <span class="at">grid-area</span>: <span class="st">main</span>; }
<span class="tg">footer</span>  { <span class="at">grid-area</span>: <span class="st">footer</span>; }</div>

  <div class="dothis">
    <h4>Do this now — build it, then rearrange it</h4>
    <p>Get the layout above working. Then swap the sidebar to the right by changing <strong>only</strong> the areas block:</p>
  </div>
  <div class="cmd"><span class="at">grid-template-columns</span>: <span class="st">1fr 240px</span>;
<span class="at">grid-template-areas</span>:
  <span class="st">"header header"</span>
  <span class="st">"main   sidebar"</span>
  <span class="st">"footer footer"</span>;</div>
  <p>The HTML never changed. The sidebar is still before <code>main</code> in the source — which matters, because screen readers and keyboard tabbing follow the DOM order, not the visual one.</p>

  <div class="cue watch"><p class="cue-k">Don't let visual order drift from DOM order</p><p>Grid lets you place anything anywhere, and <code>order</code> in Flexbox does the same. Both are easy to abuse. If a keyboard user tabs through your form and the focus jumps from the top of the page to the bottom and back, you've created that with CSS.</p><p>Reorder the HTML when the order genuinely changes. Use CSS placement for layout, not for sequence.</p></div>

  <h3>Implicit tracks</h3>
  <p>Put in more items than your template defines and Grid creates extra rows automatically. Size them with:</p>
  <div class="cmd"><span class="at">grid-auto-rows</span>: <span class="st">minmax(120px, auto)</span>;   <span class="cm">/* at least 120px, taller if needed */</span>
<span class="at">grid-auto-flow</span>: <span class="st">dense</span>;                 <span class="cm">/* backfill gaps left by spanning items */</span></div>

  <div class="quiz">
    <div class="q"><b>Q6</b>Your grid has 4 columns. What does <code>grid-column: 2 / 4</code> span, and how many lines are there in total?</div>
    <details><summary>Show answer</summary><div class="a">
      <p>It spans <strong>two columns</strong> — the 2nd and 3rd — because it runs from line 2 to line 4, and the item occupies the tracks <em>between</em> those lines.</p>
      <p>Four columns have <strong>five</strong> lines. This off-by-one is the single most common Grid confusion: you're placing between lines, not into columns.</p>
    </div></details>
  </div>

  <label class="done-check"><input type="checkbox" class="chk"><span class="dbox"></span><span>Section 13 complete</span></label>
</section>

<!-- ================= 14 ================= -->
<section id="s14">
  <div class="shead"><span class="chip">14</span><h2>Grid — the responsive one-liner</h2><span class="tagline">worth the price of admission</span></div>

  <p>This single declaration produces a card layout that reflows from four columns to one, with no media queries at all.</p>

  <div class="cmd"><span class="tg">.cards</span> {
  <span class="at">display</span>: <span class="st">grid</span>;
  <span class="at">grid-template-columns</span>: <span class="st">repeat(auto-fit, minmax(250px, 1fr))</span>;
  <span class="at">gap</span>: <span class="st">1.5rem</span>;
}</div>

  <div class="cue"><p class="cue-k">Read it inside out</p>
    <p><strong><code>minmax(250px, 1fr)</code></strong> — each column is at least 250px, and shares leftover space equally beyond that.</p>
    <p><strong><code>auto-fit</code></strong> — fit as many such columns as will go, then stretch them to fill the row.</p>
    <p><strong><code>repeat(…)</code></strong> — apply that as many times as it fits.</p>
    <p>So: as many 250px-minimum columns as the screen allows. Four on a laptop, two on a tablet, one on a phone. <strong>The layout responds to the container, not to a device you guessed about.</strong></p>
  </div>

  <div class="dothis">
    <h4>Do this now — build it and drag the window</h4>
    <p>Add six cards to your HTML and apply the rule above. Then drag the browser edge slowly from wide to narrow and watch the column count drop. No breakpoints were written.</p>
  </div>

  <h3>auto-fit vs auto-fill</h3>
  <div class="mention">
    <div class="mrow"><b>auto-fit</b><span>Collapses empty tracks, so the items you have stretch to fill the row. Usually what you want.</span></div>
    <div class="mrow"><b>auto-fill</b><span>Keeps empty tracks in place, so three cards in a five-column-wide container stay card-sized with a gap on the right. Right when you want a consistent grid regardless of item count.</span></div>
  </div>

  <div class="cue watch"><p class="cue-k">The one flaw</p><p>If the container is narrower than your minimum — a 250px minimum inside a 200px phone viewport — the track overflows. Guard it with <code>min()</code>:</p></div>
  <div class="cmd"><span class="at">grid-template-columns</span>: <span class="st">repeat(auto-fit, minmax(min(250px, 100%), 1fr))</span>;</div>
  <p>Now the minimum is 250px <em>or</em> the full container width, whichever is smaller. Nothing can overflow.</p>

  <label class="done-check"><input type="checkbox" class="chk"><span class="dbox"></span><span>Section 14 complete</span></label>
</section>

<!-- ================= 15 ================= -->
<section id="s15">
  <div class="shead"><span class="chip">15</span><h2>Flexbox or Grid?</h2><span class="tagline">a decision, not a rivalry</span></div>

  <p>They aren't competitors and you'll use both on the same page — usually Grid for the page skeleton and Flexbox inside the pieces.</p>

  <div class="mention">
    <div class="mrow"><b>Flexbox — one dimension</b><span>A row or a column. The layout follows the <em>content</em>: items size themselves and space gets distributed around them.</span></div>
    <div class="mrow"><b>Grid — two dimensions</b><span>Rows and columns together. You define the <em>structure</em> first and content goes into it.</span></div>
  </div>

  <div class="cue work"><p class="cue-k">The question that decides it</p><p><strong>"Do I care about alignment in both directions at once?"</strong></p><p>Yes → Grid. No → Flexbox.</p><p>A nav bar is one row: Flexbox. A photo gallery where every item lines up in both axes: Grid. A card's internal stack of title, text and button: Flexbox. The page skeleton of header, sidebar, main, footer: Grid.</p></div>

  <div class="cmd"><span class="cm">/* Grid for the page */</span>
<span class="tg">.page</span> { <span class="at">display</span>: <span class="st">grid</span>; <span class="at">grid-template-columns</span>: <span class="st">240px 1fr</span>; }

<span class="cm">/* Grid for the card collection */</span>
<span class="tg">.cards</span> { <span class="at">display</span>: <span class="st">grid</span>; <span class="at">grid-template-columns</span>: <span class="st">repeat(auto-fit, minmax(250px, 1fr))</span>; <span class="at">gap</span>: <span class="st">1rem</span>; }

<span class="cm">/* Flexbox INSIDE each card, to push the button to the bottom */</span>
<span class="tg">.card</span> { <span class="at">display</span>: <span class="st">flex</span>; <span class="at">flex-direction</span>: <span class="st">column</span>; <span class="at">gap</span>: <span class="st">.5rem</span>; }
<span class="tg">.card .btn</span> { <span class="at">margin-top</span>: <span class="st">auto</span>; }   <span class="cm">/* buttons align even with uneven text */</span></div>

  <p>That last line is a small piece of craft worth stealing: <code>margin-top: auto</code> on the final flex item in a column pushes it to the bottom, so a row of cards with different amounts of text still has its buttons in a straight line.</p>

  <div class="cue"><p class="cue-k">A note on floats</p><p>If you find a tutorial using <code>float</code> for layout, it's from before 2017. Floats were designed to wrap text around an image, which is still their only good use. Anything about clearfixes is a workaround for a problem you no longer have.</p></div>

  <label class="done-check"><input type="checkbox" class="chk"><span class="dbox"></span><span>Section 15 complete</span></label>
</section>

<!-- ================= 16 ================= -->
<section id="s16">
  <div class="shead"><span class="chip">16</span><h2>Position and z-index</h2><span class="tagline">taking things out of flow</span></div>

  <div class="mention">
    <div class="mrow"><b>static</b><span>The default. Sits in normal flow. <code>top</code>/<code>left</code> do nothing.</span></div>
    <div class="mrow"><b>relative</b><span>Still occupies its normal space, but can be nudged with offsets. Crucially, it becomes a <strong>positioning context</strong> for absolute children.</span></div>
    <div class="mrow"><b>absolute</b><span><strong>Removed from flow</strong> — other elements act as if it isn't there. Positioned against the nearest ancestor that isn't <code>static</code>.</span></div>
    <div class="mrow"><b>fixed</b><span>Removed from flow and positioned against the viewport. Stays put when you scroll.</span></div>
    <div class="mrow"><b>sticky</b><span>Normal until it hits a scroll threshold, then behaves like fixed within its parent. Table headers, section titles.</span></div>
  </div>

  <div class="cue"><p class="cue-k">The relative/absolute pairing</p><p>Almost every use of <code>absolute</code> comes with <code>relative</code> on its parent. Forget the parent and your badge positions itself against the whole page instead of the card it belongs to.</p></div>

  <div class="cmd"><span class="tg">.card</span>  { <span class="at">position</span>: <span class="st">relative</span>; }
<span class="tg">.badge</span> { <span class="at">position</span>: <span class="st">absolute</span>; <span class="at">top</span>: <span class="st">.5rem</span>; <span class="at">right</span>: <span class="st">.5rem</span>; }</div>

  <h3>Sticky, and why it silently fails</h3>
  <div class="cmd"><span class="tg">.toolbar</span> {
  <span class="at">position</span>: <span class="st">sticky</span>;
  <span class="at">top</span>: <span class="st">0</span>;        <span class="cm">/* REQUIRED — without a threshold it does nothing */</span>
}</div>

  <div class="cue watch"><p class="cue-k">Three reasons sticky doesn't work</p>
    <p><strong>1.</strong> No <code>top</code> (or <code>bottom</code>/<code>left</code>/<code>right</code>) value. There's no threshold to stick at, so it never activates. This is most cases.</p>
    <p><strong>2.</strong> An ancestor has <code>overflow: hidden</code>, <code>auto</code> or <code>scroll</code>. Sticky is scoped to the nearest scrolling ancestor, and a stray <code>overflow-x: hidden</code> on a wrapper kills it silently.</p>
    <p><strong>3.</strong> The parent isn't tall enough. Sticky can only travel within its own parent, so a sticky element in a short container appears not to move.</p>
  </div>

  <h3>z-index and stacking contexts</h3>
  <p><code>z-index</code> controls what sits in front. Two rules explain almost all of the confusion:</p>
  <div class="mention">
    <div class="mrow"><b>It only works on positioned elements</b><span>Anything except <code>position: static</code>. Also works on flex and grid items, which is a modern exception worth knowing.</span></div>
    <div class="mrow"><b>Stacking contexts nest</b><span>An element with a <code>z-index</code> creates a context for its children. A child with <code>z-index: 9999</code> inside a parent with <code>z-index: 1</code> can never appear above a sibling of the parent with <code>z-index: 2</code>. It's trapped.</span></div>
  </div>

  <div class="cue watch"><p class="cue-k">Which is why z-index: 9999 doesn't fix it</p><p>If a modal is stuck behind something, escalating the number won't help — the element is inside a stacking context that is itself behind. Move the element up the DOM (or use the <code>&lt;dialog&gt;</code> element, which handles this properly).</p><p>Also note: <code>transform</code>, <code>opacity</code> below 1, <code>filter</code> and <code>will-change</code> all create stacking contexts too, which is why adding a fade animation can mysteriously break layering.</p></div>

  <label class="done-check"><input type="checkbox" class="chk"><span class="dbox"></span><span>Section 16 complete</span></label>
</section>

<!-- ================= 17 ================= -->
<section id="s17">
  <div class="shead"><span class="chip">17</span><h2>Responsive design, mobile first</h2><span class="tagline">one page, every screen</span></div>

  <p>Responsive means one set of HTML and CSS that works from a 360px phone to a 27-inch monitor. The tool is the media query, but the more important part is the approach.</p>

  <div class="cmd"><span class="cm">/* base styles — written for the SMALL screen, no query needed */</span>
<span class="tg">.cards</span> { <span class="at">display</span>: <span class="st">grid</span>; <span class="at">gap</span>: <span class="st">1rem</span>; }

<span class="cm">/* then ADD complexity as the screen gets bigger */</span>
<span class="tg">@media (min-width: 40rem)</span> {
  <span class="tg">.cards</span> { <span class="at">grid-template-columns</span>: <span class="st">1fr 1fr</span>; }
}

<span class="tg">@media (min-width: 64rem)</span> {
  <span class="tg">.cards</span> { <span class="at">grid-template-columns</span>: <span class="st">repeat(4, 1fr)</span>; }
}</div>

  <div class="cue"><p class="cue-k">Why mobile first, and not the other way round</p>
    <p>A phone layout is a single column — which is what HTML does by default. So your base styles are almost nothing, and each breakpoint <em>adds</em>.</p>
    <p>Desktop-first means writing a complex layout and then unpicking it at every breakpoint, which means more code and more overrides fighting each other. It also means the phone — usually the majority of your traffic — downloads and parses all the desktop CSS before overriding it.</p>
  </div>

  <h3>Choosing breakpoints</h3>
  <div class="cue watch"><p class="cue-k">Don't target devices</p><p>There is no useful list of device widths — there are hundreds of screen sizes and they change every year. Chasing "iPhone width" is a losing game.</p><p><strong>Widen your browser slowly and add a breakpoint wherever the layout starts to look bad.</strong> Let the content decide. Most sites need two or three, not eight.</p></div>

  <div class="mention">
    <div class="mrow"><b>min-width</b><span>"From this width upwards." The mobile-first direction. Use this by default.</span></div>
    <div class="mrow"><b>max-width</b><span>"Up to this width." Occasionally useful, but mixing both directions in one stylesheet gets confusing fast.</span></div>
    <div class="mrow"><b>Use rem, not px</b><span><code>min-width: 40rem</code> respects a user who has increased their default font size. <code>640px</code> doesn't.</span></div>
    <div class="mrow"><b>prefers-reduced-motion</b><span>Not a size query, but essential: wrap your animations so people who get motion sickness can turn them off.</span></div>
  </div>

  <h3>The other things responsive needs</h3>
  <div class="cmd"><span class="cm">/* images must never exceed their container */</span>
<span class="tg">img, video</span> { <span class="at">max-width</span>: <span class="st">100%</span>; <span class="at">height</span>: <span class="st">auto</span>; }

<span class="cm">/* touch targets need to be finger-sized */</span>
<span class="tg">button, a.btn</span> { <span class="at">min-height</span>: <span class="st">44px</span>; }

<span class="cm">/* long words and URLs shouldn't blow out the layout */</span>
<span class="tg">body</span> { <span class="at">overflow-wrap</span>: <span class="st">break-word</span>; }</div>

  <div class="dothis">
    <h4>Do this now — test it honestly</h4>
    <ol>
      <li>DevTools → the device toolbar icon (<kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>M</kbd>).</li>
      <li>Set the width to <strong>360px</strong> — a realistic small phone, narrower than the presets people usually test.</li>
      <li>Scroll the whole page. <strong>Any horizontal scrollbar is a bug.</strong> Find what's overflowing.</li>
      <li>Now go the other way: 1600px. Does your text stretch into unreadable 200-character lines? Add <code>max-width: 65ch</code> to your prose container.</li>
    </ol>
  </div>

  <label class="done-check"><input type="checkbox" class="chk"><span class="dbox"></span><span>Section 17 complete</span></label>
</section>

<!-- ================= 18 ================= -->
<section id="s18">
  <div class="shead"><span class="chip">18</span><h2>Responsive without media queries</h2><span class="tagline">the modern way</span></div>

  <p>Media queries respond to the <em>viewport</em>. But a card doesn't care how wide the window is — it cares how wide <em>it</em> is. Modern CSS lets you write layouts that adapt intrinsically, and it's usually less code.</p>

  <h3>clamp() — fluid values with limits</h3>
  <div class="cmd"><span class="at">font-size</span>: <span class="st">clamp(1.5rem, 4vw, 3rem)</span>;
<span class="cm">/*          minimum | preferred | maximum */</span></div>
  <p>Scales smoothly with the viewport, never smaller than 1.5rem, never larger than 3rem. That replaces three media queries with one line, and there's no sudden jump at a breakpoint.</p>

  <div class="cmd"><span class="cm">/* fluid page gutters */</span>
<span class="at">padding-inline</span>: <span class="st">clamp(1rem, 5vw, 4rem)</span>;

<span class="cm">/* a container that's fluid but capped */</span>
<span class="at">width</span>: <span class="st">min(100% - 2rem, 65rem)</span>;
<span class="at">margin-inline</span>: <span class="st">auto</span>;</div>

  <p>That second one is a complete page container: full width minus gutters on a phone, capped at 65rem on a monitor, centred throughout. No breakpoints.</p>

  <div class="mention">
    <div class="mrow"><b>min(a, b)</b><span>Whichever is smaller. Good for "this size, but never wider than the screen".</span></div>
    <div class="mrow"><b>max(a, b)</b><span>Whichever is larger. Good for enforcing a floor.</span></div>
    <div class="mrow"><b>clamp(lo, val, hi)</b><span>Both at once. The one you'll use most.</span></div>
  </div>

  <h3>Container queries — asking about the parent</h3>
  <p>The genuinely new idea: a component can respond to the space <em>it</em> has, so the same card works in a wide main area and a narrow sidebar without knowing which it's in.</p>

  <div class="cmd"><span class="tg">.card-wrapper</span> {
  <span class="at">container-type</span>: <span class="st">inline-size</span>;
}

<span class="tg">@container (min-width: 400px)</span> {
  <span class="tg">.card</span> { <span class="at">display</span>: <span class="st">grid</span>; <span class="at">grid-template-columns</span>: <span class="st">120px 1fr</span>; }
}</div>

  <p>This is what component-based design always wanted. It's supported across all current browsers; check <a href="https://caniuse.com" target="_blank" rel="noopener">caniuse.com</a> if you need to support older ones.</p>

  <div class="cue work"><p class="cue-k">The order to reach for things</p>
    <p><strong>1.</strong> Can normal flow do it? A single column of block elements is already responsive.</p>
    <p><strong>2.</strong> Can <code>flex-wrap</code>, <code>auto-fit</code> or <code>clamp()</code> do it? Usually yes, and with no breakpoints.</p>
    <p><strong>3.</strong> Does the <em>component</em> need to change shape? Container query.</p>
    <p><strong>4.</strong> Does the <em>page structure</em> need to change? Now use a media query.</p>
    <p>Media queries are still correct for big structural shifts — sidebar becomes a drawer, three columns become one. They just shouldn't be the first tool you reach for any more.</p>
  </div>

  <label class="done-check"><input type="checkbox" class="chk"><span class="dbox"></span><span>Section 18 complete</span></label>
</section>

<!-- ================= 19 ================= -->
<section id="s19">
  <div class="shead"><span class="chip">19</span><h2>Debugging CSS in DevTools</h2><span class="tagline">stop guessing</span></div>

  <p>CSS produces no error messages. A misspelled property is simply ignored. So the browser's inspector isn't a nice extra — it's the only feedback you get.</p>

  <div class="dothis">
    <h4>Do this now — six things, in order</h4>
  </div>

  <div class="mention">
    <div class="mrow"><b>1. The Styles pane</b><span>Right-click → Inspect. Every rule matching this element, most specific at the top, with the file and line number. <strong>Anything with a line through it lost the cascade.</strong></span></div>
    <div class="mrow"><b>2. Edit values live</b><span>Click any value and type. Use arrow keys to nudge numbers — hold <kbd>Shift</kbd> for tens. Far faster than save-and-reload for finding the right spacing.</span></div>
    <div class="mrow"><b>3. The Computed tab</b><span>The final value of every property after everything resolved. When you can't work out where a value came from, expand it here — it shows the winning rule.</span></div>
    <div class="mrow"><b>4. The box model diagram</b><span>At the bottom of Styles, or in Computed. Hover each layer to highlight it on the page. The fastest way to answer "is that gap padding or margin?"</span></div>
    <div class="mrow"><b>5. Flex and grid badges</b><span>Elements with <code>display: flex</code> or <code>grid</code> get a little badge in the Elements panel. Click it to overlay the tracks, line numbers and gaps directly on the page. This makes Grid debugging almost trivial.</span></div>
    <div class="mrow"><b>6. Toggle states</b><span>The <code>:hov</code> button lets you force <code>:hover</code>, <code>:focus</code>, <code>:active</code> so you can style them without contorting yourself over the mouse.</span></div>
  </div>

  <div class="cue"><p class="cue-k">The outline trick for "what is that thing?"</p></div>
  <div class="cmd"><span class="tg">* </span>{ <span class="at">outline</span>: <span class="st">1px solid red</span>; }</div>
  <p>Every box on the page becomes visible. Use <code>outline</code> rather than <code>border</code> — outlines draw outside the box and take no space, so they don't change the layout while you're inspecting it.</p>

  <div class="cue watch"><p class="cue-k">Finding what causes horizontal scroll</p><p>A stray horizontal scrollbar on mobile is the classic hard-to-find bug. Paste this in the Console and it will list every element wider than the viewport:</p></div>
  <div class="cmd"><span class="p">&gt;</span> document.querySelectorAll('*').forEach(el =&gt; {
    if (el.scrollWidth &gt; document.documentElement.clientWidth) console.log(el);
  })</div>

  <label class="done-check"><input type="checkbox" class="chk"><span class="dbox"></span><span>Section 19 complete</span></label>
</section>

<!-- ================= 20 ================= -->
<section id="s20">
  <div class="shead"><span class="chip">20</span><h2>When it goes wrong</h2><span class="tagline">the usual suspects</span></div>

  <div class="mention">
    <div class="mrow"><b>My rule isn't applying</b><span>Three checks in order: does the selector match, is something more specific winning, is something later overriding? DevTools answers all three. See section 03.</span></div>
    <div class="mrow"><b>My boxes overflow the row</b><span><code>box-sizing: border-box</code> missing. Section 04.</span></div>
    <div class="mrow"><b>The gap is smaller than I set</b><span>Margin collapse. Use <code>gap</code> instead. Section 05.</span></div>
    <div class="mrow"><b>height does nothing</b><span>The element is <code>display: inline</code>. Section 06.</span></div>
    <div class="mrow"><b>A flex item won't shrink</b><span><code>min-width: auto</code> is the default on flex items. Set <code>min-width: 0</code>. Section 11.</span></div>
    <div class="mrow"><b>My grid span is off by one</b><span>You're placing between <em>lines</em>, and N columns have N+1 lines. Section 13.</span></div>
    <div class="mrow"><b>position: sticky does nothing</b><span>Missing <code>top</code>, or an ancestor has <code>overflow</code> set. Section 16.</span></div>
    <div class="mrow"><b>z-index: 9999 isn't working</b><span>You're trapped inside a stacking context. Section 16.</span></div>
    <div class="mrow"><b>Media queries are ignored on mobile</b><span>Missing <code>&lt;meta name="viewport"&gt;</code>. Section 01.</span></div>
    <div class="mrow"><b>Horizontal scrollbar on mobile</b><span>Something is wider than the screen — an image with no <code>max-width</code>, a fixed-width element, a long unbroken string, or negative margins. Use the Console snippet in section 19.</span></div>
    <div class="mrow"><b>100vh is too tall on a phone</b><span>Mobile browser chrome. Use <code>100dvh</code>. Section 07.</span></div>
    <div class="mrow"><b>A whole block of rules stopped working</b><span>A missing semicolon or closing brace earlier in the file. The parser skips ahead to what it thinks is the next rule and swallows several. Check the line just above where things break.</span></div>
  </div>

  <div class="cue"><p class="cue-k">Two general techniques</p>
    <p><strong>Comment out half.</strong> Same bisection method as debugging anything else. Comment out half your stylesheet; if the problem persists it's in the other half. Five rounds narrows 500 lines to fifteen.</p>
    <p><strong>Validate it.</strong> <a href="https://jigsaw.w3.org/css-validator/" target="_blank" rel="noopener">jigsaw.w3.org/css-validator</a> catches typos and syntax errors that the browser silently ignores.</p>
  </div>

  <div class="cue calm"><p class="cue-k">Asking for help is a skill, not a failure</p><p>When you're properly stuck, ask someone — and have a screenshot of both <strong>the Styles pane</strong> and <strong>what you expected</strong> ready when you do. For CSS specifically, a link to a minimal reproduction on CodePen gets you an answer far faster than a description.</p></div>

  <label class="done-check"><input type="checkbox" class="chk"><span class="dbox"></span><span>Section 20 complete</span></label>
</section>

<!-- ================= 21 ================= -->
<section id="s21">
  <div class="shead"><span class="chip">21</span><h2>Practice run, unaided</h2><span class="tagline">the part that makes it stick</span></div>

  <p>Build this <strong>without scrolling up</strong>. When you're stuck, open DevTools and look at what the browser actually did before you look anything up.</p>

  <div class="dothis">
    <h4>The task — a course dashboard page</h4>
    <ol>
      <li>Start a fresh <code>index.html</code> and <code>style.css</code>. First three lines of CSS: the <code>border-box</code> reset.</li>
      <li>Define at least four custom properties on <code>:root</code> — two colours, a spacing unit, a border radius — and use them throughout. No raw hex values below <code>:root</code>.</li>
      <li><strong>Page skeleton with Grid:</strong> header across the top, a 240px sidebar, main content, footer across the bottom. Use <code>grid-template-areas</code>. Full viewport height with the footer at the bottom even when content is short.</li>
      <li><strong>Header with Flexbox:</strong> a title on the left, three nav links on the right, vertically centred, using <code>gap</code> and no margins.</li>
      <li><strong>Card grid in main:</strong> six cards using <code>repeat(auto-fit, minmax(250px, 1fr))</code>. No media query for this.</li>
      <li><strong>Each card with Flexbox:</strong> a column containing a title, a variable amount of text, and a button. Every button must line up along the bottom regardless of text length.</li>
      <li>Give one card a "New" badge in its top-right corner using <code>relative</code> and <code>absolute</code>.</li>
      <li>Make the header <code>sticky</code> at the top on scroll.</li>
      <li>Fluid heading size with <code>clamp()</code>. Prose capped at <code>65ch</code>.</li>
      <li><strong>One media query only:</strong> below 48rem, the sidebar moves above main and the layout becomes a single column.</li>
    </ol>
  </div>

  <div class="dothis">
    <h4>Then verify it — this half matters as much</h4>
    <ol>
      <li>360px wide in the device toolbar. <strong>Zero horizontal scroll.</strong></li>
      <li>1600px wide. No line of text longer than about 65 characters.</li>
      <li>Every width in between, dragged slowly. Nothing overlaps, nothing jumps awkwardly.</li>
      <li>Turn on the grid overlay badge and check your tracks are what you think they are.</li>
      <li>Tab through the page. Focus order sensible, focus rings visible.</li>
      <li>Switch your OS to dark mode. If you did section 08, it should follow.</li>
      <li>Search your stylesheet for <code>!important</code>. There should be none.</li>
    </ol>
  </div>

  <div class="cue"><p class="cue-k">How to judge yourself</p><p>You're ready if you built it needing DevTools but not this document. Nearly ready if you looked up two or three property names — nobody memorises every <code>justify-content</code> value.</p><p>The real test isn't the properties. It's whether, when something looked wrong, you <em>knew where to look</em> instead of changing numbers until it moved.</p></div>

  <label class="done-check"><input type="checkbox" class="chk"><span class="dbox"></span><span>Section 21 complete</span></label>
</section>

<!-- ================= 22 ================= -->
<section id="s22">
  <div class="shead"><span class="chip">22</span><h2>Final checkpoint</h2><span class="tagline">answer before revealing</span></div>

  <p>Fifteen questions. Answer each in your head — or better, write it down — <em>before</em> opening the answer. Getting one wrong is information, not failure; go back to the section it came from.</p>

  <div class="quiz"><div class="q"><b>1</b>Name the four layers of the box model, from the inside out.</div>
    <details><summary>Show answer</summary><div class="a"><p>Content, padding, border, margin. Padding is inside the border and takes the background; margin is outside and is always transparent.</p></div></details></div>

  <div class="quiz"><div class="q"><b>2</b><code>width: 200px; padding: 20px; border: 5px</code>. How wide on screen, and how do you make it 200?</div>
    <details><summary>Show answer</summary><div class="a"><p><strong>250px</strong> by default (<code>content-box</code>). Set <code>box-sizing: border-box</code> — universally as <code>*, *::before, *::after { box-sizing: border-box }</code> — and it becomes exactly 200px.</p></div></details></div>

  <div class="quiz"><div class="q"><b>3</b>Two stacked elements, 30px bottom margin and 20px top margin. What's the gap?</div>
    <details><summary>Show answer</summary><div class="a"><p><strong>30px.</strong> Adjacent vertical margins collapse to the larger of the two. Avoid the whole topic by using <code>gap</code> on a flex or grid parent, where margins never collapse.</p></div></details></div>

  <div class="quiz"><div class="q"><b>4</b>Put these in specificity order: <code>#nav a</code>, <code>.nav .link</code>, <code>nav ul li a</code>.</div>
    <details><summary>Show answer</summary><div class="a"><p><code>#nav a</code> is 1-0-1, <code>.nav .link</code> is 0-2-0, <code>nav ul li a</code> is 0-0-4. So: <strong>#nav a &gt; .nav .link &gt; nav ul li a</strong>.</p><p>Columns are compared left to right, not summed — one id beats any number of classes, and one class beats any number of elements.</p></div></details></div>

  <div class="quiz"><div class="q"><b>5</b>Which of these inherit: <code>color</code>, <code>padding</code>, <code>font-family</code>, <code>border</code>?</div>
    <details><summary>Show answer</summary><div class="a"><p><code>color</code> and <code>font-family</code> inherit. <code>padding</code> and <code>border</code> don't.</p><p>Rule of thumb: text-related properties inherit, box-related ones don't.</p></div></details></div>

  <div class="quiz"><div class="q"><b>6</b>Why prefer <code>rem</code> over <code>em</code> for font sizes?</div>
    <details><summary>Show answer</summary><div class="a"><p><code>em</code> is relative to the element's own font size, so it compounds through nesting — three nested 1.2em elements give 1.728×. <code>rem</code> always refers to the root, so it never compounds.</p><p>Both beat <code>px</code> for text, because both respect a user's browser font-size setting.</p></div></details></div>

  <div class="quiz"><div class="q"><b>7</b>In <code>flex-direction: column</code>, which property centres items vertically?</div>
    <details><summary>Show answer</summary><div class="a"><p><code>justify-content: center</code> — because in a column the main axis is vertical, and <code>justify-*</code> always works on the main axis.</p><p><code>align-items</code> would centre them horizontally there.</p></div></details></div>

  <div class="quiz"><div class="q"><b>8</b>What does <code>flex: 1</code> expand to, and what does each part mean?</div>
    <details><summary>Show answer</summary><div class="a"><p><code>flex: 1 1 0%</code> — grow 1 (take a share of free space), shrink 1 (give up space when cramped), basis 0% (ignore content width when dividing).</p><p>Which is why several <code>flex: 1</code> items end up equal width regardless of their content.</p></div></details></div>

  <div class="quiz"><div class="q"><b>9</b>A flex item containing a long URL is forcing a horizontal scrollbar. Fix?</div>
    <details><summary>Show answer</summary><div class="a"><p><code>min-width: 0</code> on the flex item. Flex items default to <code>min-width: auto</code>, meaning they refuse to shrink below their content's intrinsic size.</p><p>Add <code>overflow-wrap: break-word</code> so the URL wraps rather than being clipped.</p></div></details></div>

  <div class="quiz"><div class="q"><b>10</b>A grid has 3 columns. How many lines, and what does <code>grid-column: 1 / -1</code> do?</div>
    <details><summary>Show answer</summary><div class="a"><p><strong>Four lines.</strong> N columns means N+1 lines.</p><p><code>1 / -1</code> spans from the first line to the last — full width — and keeps working if the column count changes.</p></div></details></div>

  <div class="quiz"><div class="q"><b>11</b>Explain <code>repeat(auto-fit, minmax(250px, 1fr))</code>.</div>
    <details><summary>Show answer</summary><div class="a"><p>Fit as many columns as possible, each at least 250px wide, sharing any leftover space equally. Empty tracks collapse so the real items stretch to fill the row.</p><p>Result: a responsive card grid that reflows at any width, with no media queries.</p></div></details></div>

  <div class="quiz"><div class="q"><b>12</b>Flexbox or Grid — what's the deciding question?</div>
    <details><summary>Show answer</summary><div class="a"><p>"Do I need alignment in two dimensions at once?" Yes → Grid. No → Flexbox.</p><p>Flexbox is content-out (one row or column, items size themselves); Grid is layout-in (you define the structure first). Most real pages use Grid for the skeleton and Flexbox inside the parts.</p></div></details></div>

  <div class="quiz"><div class="q"><b>13</b>Give three reasons <code>position: sticky</code> silently does nothing.</div>
    <details><summary>Show answer</summary><div class="a"><p>No <code>top</code>/<code>bottom</code> threshold set; an ancestor has <code>overflow</code> hidden/auto/scroll; or the parent isn't tall enough for the element to travel within.</p></div></details></div>

  <div class="quiz"><div class="q"><b>14</b>Why is mobile-first the right default?</div>
    <details><summary>Show answer</summary><div class="a"><p>A single-column phone layout is close to what HTML does anyway, so the base styles are minimal and each <code>min-width</code> query <em>adds</em> complexity. Desktop-first means writing everything then unpicking it, which produces more code and override wars — and makes phones parse desktop CSS they'll never use.</p></div></details></div>

  <div class="quiz"><div class="q"><b>15</b>Your media queries have no effect on a real phone. What's the first thing to check?</div>
    <details><summary>Show answer</summary><div class="a"><p><code>&lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;</code> in the head. Without it a phone reports itself as roughly 980px wide, so no small-screen query ever matches.</p></div></details></div>

  <label class="done-check"><input type="checkbox" class="chk"><span class="dbox"></span><span>Section 22 complete</span></label>
</section>

<!-- ================= GLOSSARY ================= -->
<section id="gloss">
  <div class="shead"><span class="chip">—</span><h2>Glossary</h2><span class="tagline">come back to this</span></div>

  <div class="gloss">
    <div class="grow"><b>block formatting context</b><span>An isolated layout region. Created by <code>display: flow-root</code>, flex, grid and others. Stops margins escaping.</span></div>
    <div class="grow"><b>border-box</b><span>Sizing mode where <code>width</code> includes padding and border. What you want, always.</span></div>
    <div class="grow"><b>breakpoint</b><span>A width at which a media query changes the layout. Chosen by content, not by device.</span></div>
    <div class="grow"><b>cascade</b><span>The procedure that decides which rule wins: importance, then specificity, then source order.</span></div>
    <div class="grow"><b>clamp()</b><span><code>clamp(min, preferred, max)</code> — a fluid value with hard limits.</span></div>
    <div class="grow"><b>container query</b><span>A query on a parent element's size rather than the viewport's.</span></div>
    <div class="grow"><b>cross axis</b><span>The axis perpendicular to <code>flex-direction</code>. Controlled by <code>align-*</code>.</span></div>
    <div class="grow"><b>custom property</b><span><code>--name: value</code>, read with <code>var()</code>. A real runtime variable that inherits.</span></div>
    <div class="grow"><b>declaration</b><span>One <code>property: value</code> pair.</span></div>
    <div class="grow"><b>flex item</b><span>A direct child of a <code>display: flex</code> element.</span></div>
    <div class="grow"><b>fr</b><span>A fraction of leftover grid space, calculated after gaps and fixed tracks.</span></div>
    <div class="grow"><b>gap</b><span>Space between flex or grid children. Replaces sibling margins.</span></div>
    <div class="grow"><b>inheritance</b><span>Text properties passing down the tree automatically; box properties not.</span></div>
    <div class="grow"><b>main axis</b><span>The direction of <code>flex-direction</code>. Controlled by <code>justify-content</code>.</span></div>
    <div class="grow"><b>margin collapse</b><span>Adjacent vertical margins merging into the larger of the two.</span></div>
    <div class="grow"><b>media query</b><span><code>@media (min-width: …)</code> — rules that apply only at certain viewport conditions.</span></div>
    <div class="grow"><b>minmax()</b><span>A grid track that is at least one size and at most another.</span></div>
    <div class="grow"><b>normal flow</b><span>The default arrangement: blocks stack down, inlines run along a line.</span></div>
    <div class="grow"><b>rem</b><span>Relative to the root font size. Your default unit.</span></div>
    <div class="grow"><b>specificity</b><span>The ids-classes-elements score deciding which selector wins.</span></div>
    <div class="grow"><b>stacking context</b><span>A layering scope. Children can't escape their parent's position in the stack.</span></div>
    <div class="grow"><b>track</b><span>One grid column or row. Lines are the dividers between tracks.</span></div>
    <div class="grow"><b>viewport</b><span>The visible area of the browser window.</span></div>
  </div>

  <label class="done-check"><input type="checkbox" class="chk"><span class="dbox"></span><span>Glossary read</span></label>
</section>

<div class="finish">
  <h2>How to know you're ready</h2>
  <p><strong>There is nothing to submit.</strong> No form, no upload, nothing to send anywhere. This is for your own benefit, and the only person who needs to be satisfied by it is you.</p>
  <p>You're there if you can do all of these <em>without looking anything up</em>:</p>
  <ol>
    <li>Name the four layers of the box model and explain what <code>box-sizing: border-box</code> changes.</li>
    <li>Work out which of two competing rules wins, and prove it in DevTools.</li>
    <li>Say which properties inherit and which don't, and why that split makes sense.</li>
    <li>Build a nav bar and a centred layout with Flexbox, without guessing at the axes.</li>
    <li>Explain what <code>flex: 1</code> expands to.</li>
    <li>Build a responsive card grid with <code>repeat(auto-fit, minmax(…))</code> and explain it line by line.</li>
    <li>Choose between Flexbox and Grid and say why in one sentence.</li>
    <li>Write a mobile-first media query, and know when you don't need one at all.</li>
  </ol>
  <p>If any of those feels shaky, go back to the section it came from and build the example again. Nobody is checking, so there's no reason to pretend otherwise to yourself.</p>

  <h2 style="margin-top:30px;font-size:20px">The four lines every stylesheet starts with</h2>
  <div class="cmd"><span class="tg">*, *::before, *::after</span> { <span class="at">box-sizing</span>: <span class="st">border-box</span>; }
<span class="tg">body</span> { <span class="at">margin</span>: <span class="st">0</span>; <span class="at">font-family</span>: <span class="st">system-ui, sans-serif</span>; <span class="at">line-height</span>: <span class="st">1.6</span>; }
<span class="tg">img, video</span> { <span class="at">max-width</span>: <span class="st">100%</span>; <span class="at">height</span>: <span class="st">auto</span>; }
<span class="tg">h1, h2, h3, p</span> { <span class="at">margin-block</span>: <span class="st">0 1rem</span>; }   <span class="cm">/* one direction only */</span></div>

  <h2 style="margin-top:24px;font-size:20px">Flexbox card</h2>
  <div class="cmd"><span class="cm">/* on the container */</span>
<span class="at">display</span>: <span class="st">flex</span>;
<span class="at">flex-direction</span>: <span class="st">row | column</span>;
<span class="at">flex-wrap</span>: <span class="st">wrap</span>;
<span class="at">gap</span>: <span class="st">1rem</span>;
<span class="at">justify-content</span>: <span class="st">flex-start | center | space-between | space-evenly</span>;  <span class="cm">/* main */</span>
<span class="at">align-items</span>: <span class="st">stretch | center | flex-start | baseline</span>;              <span class="cm">/* cross */</span>

<span class="cm">/* on the items */</span>
<span class="at">flex</span>: <span class="st">1</span>;              <span class="cm">/* = 1 1 0%  — equal, fluid */</span>
<span class="at">flex</span>: <span class="st">0 0 240px</span>;       <span class="cm">/* fixed, never flexes */</span>
<span class="at">align-self</span>: <span class="st">center</span>;   <span class="cm">/* override just this one */</span>
<span class="at">margin-top</span>: <span class="st">auto</span>;     <span class="cm">/* push to the end of a column */</span>
<span class="at">min-width</span>: <span class="st">0</span>;         <span class="cm">/* allow shrinking past content */</span></div>

  <h2 style="margin-top:24px;font-size:20px">Grid card</h2>
  <div class="cmd"><span class="cm">/* on the container */</span>
<span class="at">display</span>: <span class="st">grid</span>;
<span class="at">grid-template-columns</span>: <span class="st">240px 1fr</span>;
<span class="at">grid-template-columns</span>: <span class="st">repeat(auto-fit, minmax(250px, 1fr))</span>;  <span class="cm">/* responsive */</span>
<span class="at">grid-template-areas</span>: <span class="st">"header header" "side main"</span>;
<span class="at">grid-auto-rows</span>: <span class="st">minmax(120px, auto)</span>;
<span class="at">gap</span>: <span class="st">1rem</span>;
<span class="at">place-items</span>: <span class="st">center</span>;

<span class="cm">/* on the items */</span>
<span class="at">grid-column</span>: <span class="st">1 / 3</span>;      <span class="cm">/* between lines 1 and 3 */</span>
<span class="at">grid-column</span>: <span class="st">span 2</span>;     <span class="cm">/* two tracks from wherever it lands */</span>
<span class="at">grid-column</span>: <span class="st">1 / -1</span>;     <span class="cm">/* full width, any column count */</span>
<span class="at">grid-area</span>: <span class="st">main</span>;         <span class="cm">/* into a named area */</span></div>

  <h2 style="margin-top:24px;font-size:20px">Responsive card</h2>
  <div class="cmd"><span class="at">font-size</span>: <span class="st">clamp(1.5rem, 4vw, 3rem)</span>;
<span class="at">width</span>: <span class="st">min(100% - 2rem, 65rem)</span>;  <span class="at">margin-inline</span>: <span class="st">auto</span>;
<span class="at">padding-inline</span>: <span class="st">clamp(1rem, 5vw, 4rem)</span>;
<span class="at">max-width</span>: <span class="st">65ch</span>;                  <span class="cm">/* readable line length */</span>
<span class="at">min-height</span>: <span class="st">100dvh</span>;                <span class="cm">/* not 100vh */</span>

<span class="tg">@media (min-width: 48rem)</span> { <span class="cm">/* mobile first: add, don't remove */</span> }
<span class="tg">@container (min-width: 400px)</span> { <span class="cm">/* needs container-type on the parent */</span> }
<span class="tg">@media (prefers-reduced-motion: reduce)</span> { <span class="cm">/* turn animations off */</span> }</div>
</div>

